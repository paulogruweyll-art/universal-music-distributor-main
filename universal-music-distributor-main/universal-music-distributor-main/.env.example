# Public Supabase URL and publishable key. These are intentionally VITE_ variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side aliases used by the authenticated server middleware.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Direct database connection string used only by `npm run db:migrate`.
# Store the real value in Replit Secrets; never commit it.
LOVABLE_DB_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
